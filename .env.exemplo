# Modelo. Copie para .env e preencha com a sua rede.
#   cp .env.exemplo .env
# O .env esta no .gitignore e nunca e versionado.
WIFI_SSID=nome-da-sua-rede
WIFI_PASSWORD=senha-da-sua-rede

# Senha da atualizacao pelo Wi-Fi (OTA) e da rede propria ESTUFA-SETUP, que a
# placa abre quando perde a rede de casa. Minimo de 8 caracteres (WPA2).
SENHA_PADRAO=troque-por-8-ou-mais
